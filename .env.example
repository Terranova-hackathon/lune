
# Copy to .env and fill in the REQUIRED values. Never commit .env.
# Avoid "$" in values: Compose treats it as a variable (write "$$" for a literal $).

#------- DEFAULTS (Can be changed by user or left as-is)------#

# Prefix for container, network and volume names (e.g. lune-backend-1).
COMPOSE_PROJECT_NAME=lune

# Development turns on the API reference (/docs) and the OpenAPI document.
ASPNETCORE_ENVIRONMENT=Development

# Only needed in Production
# PUBLIC_URL=

#----------------TO BE FILLED BY USER -----------------------#

# Where the frontend dev server sends /api requests.
# Leave it empty to use the default backend API url: http://backend:3001
API_URL=

# REQUIRED SQL Server 'sa' password: 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=

# REQUIRED Secret used to sign login tokens: at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# REQUIRED Twitch dev IGDB id and secret to connect to the internet game data base.
# get your key here https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_API_SECRET=

# STRONGLY RECOMMENDED. Adds GG.deals prices for price comparison w/ steam
# Free key from https://gg.deals/api/
GGDEALS_API_KEY=

#-----------------------------------------------------------#

# SERVICE DEPRECATED - switched from RAWG to IGDB due to service outage
# backend structures for RAWG retained for possible reconnection
# Free key from https://rawg.io/apidocs [SERVICE DEPRECIATED]
# RAWG_API_KEY=

# PLANNED Futuree Steam integration
# Free key from https://steamcommunity.com/dev/apikey [FUTURE]
# STEAM_API_KEY=

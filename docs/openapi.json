{
  "openapi": "3.1.1",
  "info": {
    "title": "Lune Backend API",
    "description": "![Lune](/icons/eclipse/apple-touch-icon.png)\n\nBackend for **LunaNova**, a game search site. Anyone can search and browse games;\nsigned-in users can also save games to their favorites.\n\nGame data comes from [IGDB](https://www.igdb.com/). Prices come from Steam and\n[GG.deals](https://gg.deals/), currently for the Italian region only.\n\n## Authentication\n\nSign-in uses a JWT in an **HttpOnly cookie** (`Lune_auth`), not an `Authorization` header.\n`POST /api/auth/register` or `POST /api/auth/login` sets the cookie, and the browser sends it\nautomatically from then on. Sessions last 24 hours; `POST /api/auth/logout` ends one.\nEndpoints marked \"Requires sign-in\" return `401` without a valid cookie.\n\nAccounts need a password of at least 8 characters with an uppercase letter, a lowercase letter,\na digit and a symbol. Display names are optional, 2–20 characters, and unique.\n\n## Conventions\n\n- **Game IDs** are IGDB IDs, shared by Games, Favorites and Prices.\n- **Paging:** list endpoints take `page` (from 1) and `pageSize` (1–40) and return\n`items`, `page`, `pageSize`, `totalCount` and `totalPages`.\n- **Errors** use [Problem Details](https://www.rfc-editor.org/rfc/rfc9457). Invalid input\nreturns `400` with an `errors` object; most keys are field names, but password and\nduplicate-email errors use ASP.NET Identity codes (e.g. `PasswordRequiresUpper`).\n- **503** means an outside provider (IGDB, Steam or GG.deals) didn't respond. Retrying later\nusually works.",
    "contact": {
      "name": "Lune Backend API for LunaNova Games Site",
      "url": "https://lunanova.games"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:3001/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Liveness check for monitoring and Docker. Returns the plain-text string `ok` when the API process is running. It does not check the database or external providers.",
        "operationId": "Health Check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness Check",
        "description": "Checks that the API can reach its database. Returns 200 with `status: Healthy` when ready, or 503 with the failing check when not. Use for readiness probes; `/health` only checks that the process is up.",
        "operationId": "Readiness Check",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Search Games",
        "description": "Search the game catalog by name, filters, or both. With no search term, the most-rated games are listed first; with a search term, results are sorted by name. `ordering` overrides either default. Within one filter, values are OR-ed (any listed genre matches); different filters are AND-ed. Games without a release date or rating are never included.",
        "operationId": "Main Search",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Text to match anywhere in the game name. Leave empty to browse the most-rated games.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Results per page, 1–40. Default 20.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "genres",
            "in": "query",
            "description": "Comma-separated genre slugs, up to 10. Get valid values from `GET /api/games/filters`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platforms",
            "in": "query",
            "description": "Comma-separated platform IDs, up to 10. Example: `6,167` (PC, PlayStation 5). Get valid values from `GET /api/games/filters`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "developers",
            "in": "query",
            "description": "Comma-separated developer slugs, up to 10. Get slugs from `GET /api/games/companies?kind=developer`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishers",
            "in": "query",
            "description": "Comma-separated publisher slugs, up to 10. Get slugs from `GET /api/games/companies?kind=publisher`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ordering",
            "in": "query",
            "description": "Sort order: `-rating`, `-metacritic`, `-released`, `released`, `-added` (most rated) or `name`. A leading `-` means descending. Default: most rated when browsing, name A–Z when searching.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "metacriticMin",
            "in": "query",
            "description": "Minimum critic score, 0–100. Game Database has no Metacritic score, so this uses Game Database's critic rating.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "metacriticMax",
            "in": "query",
            "description": "Maximum critic score, 0–100. Must not be lower than `metacriticMin`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfGameSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get Game By ID",
        "description": "Full details for one game: summary, storyline, genres, platforms, developers, publishers, store links, and media as ready-to-use URLs (cover, 1080p screenshots and artwork, YouTube videos). `backgroundImage` is a randomly chosen screenshot, so it can differ between calls. Also includes a paged list of similar games in `relatedGames`; `page` and `pageSize` page through that list only.",
        "operationId": "Get Game By ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Game Database game ID. The same ID works with /api/favorites and /api/prices.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page of related games, starting at 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Related games per page, 1–40. Default 6.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/filters": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get Filter Options",
        "description": "Everything the search filters accept, for building the filter UI. Each option has a `value` to send and a `name` to display. `genres` lists all Game Database genres(value = slug, for the `genres` parameter).`platforms` lists the platforms Lune supports (value = platform ID, for the `platforms` parameter). `orderings` lists the sort orders for the `ordering` parameter. Cached on the server for 10 minutes.",
        "operationId": "Get Filter Options",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameFilterOptions"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/companies": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Search Companies",
        "description": "Find developers or publishers by name, for example to fill a filter autocomplete. Matches anywhere in the name, case-insensitive. Returns up to 10 companies, those with the most games first. Pass a result's `slug` to the `developers` or `publishers` parameter of `GET /api/games`.",
        "operationId": "Search Companies",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "description": "Required. `developer` or `publisher`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Required. Part of the company name, 2–60 characters. Example: `ubi`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompanyOption"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/featured": {
      "get": {
        "tags": [
          "Games"
        ],
        "summary": "Get Featured Games",
        "description": "10 games picked at random from the 50 most-rated on Game Database, for the home page.The selection changes on every call. Each item has the same shape as `GET /api/games/{id}`, but `relatedGames` is always empty and `backgroundImage` is the game's first 1080p screenshot (or its cover).",
        "operationId": "Get Featured Games",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameDetails"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register",
        "description": "Create an account and sign in. On success the server sets the HttpOnly auth cookie, so no separate login is needed. Password: at least 8 characters, with an uppercase letter, a lowercase letter, a digit and a symbol. Email must not already be registered. Display name is optional; if given, it must be unique. `acceptedPrivacyPolicy` must be `true`. Validation errors return 400, keyed by field or by Identity error code.",
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Sign in with email and password. On success the server sets the HttpOnly auth cookie (valid for 24 hours) and returns the user. A wrong password and an unknown email both return the same 401, so the response does not reveal whether an account exists.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "description": "Sign out by clearing the auth cookie. Always returns 204, even if no one is signed in.",
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get Current User",
        "description": "Return the signed-in user. Use it to check whether the auth cookie is still valid, for example on page load. `displayName` is null if the user never set one. Returns 401 if not signed in, the session has expired, or the account no longer exists. Requires sign-in.",
        "operationId": "Get Current User",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/profile": {
      "put": {
        "tags": [
          "Auth"
        ],
        "summary": "Update Profile",
        "description": "Change the signed-in user's display name. The name is trimmed, must be 2–20 characters, and must not be used by another account (case-insensitive). Returns the updated user. Requires sign-in.",
        "operationId": "Update Profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileDisplayNameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/delete-account": {
      "delete": {
        "tags": [
          "Auth"
        ],
        "summary": "Delete Account",
        "description": "Permanently delete the signed-in user's account and all of their data, including saved favorites, then clear the auth cookie. This cannot be undone. Requires sign-in.",
        "operationId": "Delete Account",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/favorites": {
      "get": {
        "tags": [
          "Favorites"
        ],
        "summary": "List Favorites",
        "description": "The signed-in user's saved games, newest first, in the same shape as search results. Game details are a copy taken when the game was saved, so they still load if Game Database is unavailable but may not reflect later changes. Requires sign-in.",
        "operationId": "List Favorites",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Results per page, 1–40. Default 20.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfGameSummary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/favorites/ids": {
      "get": {
        "tags": [
          "Favorites"
        ],
        "summary": "List Favorite IDs",
        "description": "The Game Database IDs of all the signed-in user's saved games, as one unpaged array in no particular order. Use it to mark favorites in search results (for example a filled heart) without loading full game data. Requires sign-in.",
        "operationId": "List Favorite IDs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "pattern": "^-?(?:0|[1-9]\\d*)$",
                    "type": [
                      "integer",
                      "string"
                    ],
                    "format": "int32"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/favorites/{Id}": {
      "put": {
        "tags": [
          "Favorites"
        ],
        "summary": "Add Favorite",
        "description": "Save a game to the signed-in user's favorites. No request body. Safe to repeat: saving a game that is already a favorite also returns 201. Each user can save up to 1000 games (409 when full). Returns 404 if Game Database has no game with this ID. Requires sign-in.",
        "operationId": "Add Favorite",
        "parameters": [
          {
            "name": "Id",
            "in": "path",
            "description": "Game Database game ID to save, the same ID used by /api/games.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Favorites"
        ],
        "summary": "Remove Favorite",
        "description": "Remove a game from the signed-in user's favorites. Safe to repeat: returns 204 whether or not the game was saved. Requires sign-in.",
        "operationId": "Remove Favorite",
        "parameters": [
          {
            "name": "Id",
            "in": "path",
            "description": "Game Database ID to remove.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/prices/{Id}": {
      "get": {
        "tags": [
          "Prices"
        ],
        "summary": "Get Price Comparison",
        "description": "Prices for a game on Steam and GG.deals, (currently only in the Italian region). Games are matched to stores by their Steam app ID, so a game that IGDB doesn't link to Steam returns 404. Steam gives the current price only (`historicalLow` is null); GG.deals gives the current price and the historical low. `averagePrice` is not filled in yet. If one store fails, the other is still returned. 503 means no store returned a price; this currently also happens for free games. Prices are cached for up to 6 hours.",
        "operationId": "Get Price Comparison",
        "parameters": [
          {
            "name": "Id",
            "in": "path",
            "description": "Game Database game ID, the same ID used by /api/games.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamePriceComparison"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompanyOption": {
        "required": [
          "slug",
          "name",
          "gamesCount"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "gamesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
